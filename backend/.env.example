# Backend configuration. Copy to backend/.env and fill in.
# Never commit a filled-in copy of this file. backend/.gitignore covers .env.
#
# The defaults below run the whole backend with NO credentials at all:
# SQLite, dev tokens, deterministic agents. Add credentials alongside them and
# switch the three mode variables over only once each path is verified.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Which connection string below is actually used.
#   local    -> DATABASE_URL. No credentials needed; use this if you do not
#               have the Supabase details.
#   supabase -> SUPABASE_DATABASE_URL. Shared team database.
DB_TARGET=local

DATABASE_URL=sqlite:///./bitnbuild.db

# Supabase Postgres. Get this from the dashboard's green "Connect" button ->
# "Direct Connection" tab -> the SESSION POOLER string (port 5432, host ends
# in .pooler.supabase.com). Then:
#   1. copy the host EXACTLY - the aws-N- index is not derivable from a region
#   2. replace [YOUR-PASSWORD] with the database password
#   3. change postgresql:// to postgresql+psycopg://
SUPABASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# dev      -> accept "Bearer dev:<email>" for seeded demo users. Local only.
# supabase -> verify real Supabase access tokens. Requires SUPABASE_URL.
AUTH_MODE=dev

# Settings -> General -> Project ID, as https://<project-id>.supabase.co
SUPABASE_URL=

# Settings -> API Keys -> "Secret keys" section (sb_secret_...).
# This is the new name for what used to be called service_role. Full admin
# access - backend only, never in frontend code, never committed.
# Used only by the demo-account provisioning script.
SUPABASE_SECRET_KEY=

# Only for a legacy project that still signs tokens with a shared HS256
# secret. If Settings -> JWT Keys shows an ECC/RSA signing key, leave blank.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Agents
# ---------------------------------------------------------------------------
# fake   -> deterministic local negotiator. Labelled as simulated in every event.
# gemini -> Gemini Developer API via google-genai.
AGENT_MODE=fake

# https://aistudio.google.com/apikey  (free tier, no card required)
GEMINI_API_KEY=

# Pick a model your account actually has free-tier quota for - check
# https://aistudio.google.com/rate-limit . As of Sept 2026 the full Flash
# models (gemini-3.8/3.7/3.5-flash, gemini-2.5-flash) are capped around
# 20 requests/day on the free tier, which is far too low: one negotiation
# against three sellers costs up to 27 calls. Flash-Lite gets ~500/day.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# Negotiation limits
# ---------------------------------------------------------------------------
MAX_ROUNDS_PER_CANDIDATE=4
MAX_CANDIDATES_PER_NEGOTIATION=3
MAX_TRANSPORT_OPTIONS_PER_LISTING=2

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
